# Copy to phone.env only if you want persistent phone-local settings.
# Never commit phone.env with real keys.

# Monolith: point to an extracted monolith root OR an exact interface manifest.
# AXM_PHONE_MONOLITH_ROOT=/data/data/com.termux/files/home/AXM/monolith
# AXM_PHONE_MONOLITH_MANIFEST=/data/data/com.termux/files/home/AXM/monolith/axm-cartridge.json

# PRIMARY CURRENT ROUTE: OpenAI / provider id "chatgpt".
# This mirrors the existing collaboration-platform bridge naming.
# It is the OpenAI API route, not this exact ChatGPT conversation session.
# OPENAI_API_KEY=
# AXM_PHONE_OPENAI_MODEL=

# Optional future/local fallback: OpenAI-compatible model server on this phone.
# AXM_PHONE_LOCAL_URL=http://127.0.0.1:1234
# AXM_PHONE_LOCAL_MODEL=local-model

# Dormant compatibility only. Not required for the current phone path.
# ANTHROPIC_API_KEY=
# AXM_PHONE_CLAUDE_MODEL=

# Bridge itself stays phone-local by default.
AXM_PHONE_BRIDGE_HOST=127.0.0.1
AXM_PHONE_BRIDGE_PORT=8787
AXM_PHONE_BRIDGE_RATE=30
